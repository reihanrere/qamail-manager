# The client address. Behind a reverse proxy $remote_addr is the proxy's own address, which
# would give every user one shared login rate-limit key. Requests from TRUSTED_PROXY_CIDR may name
# the real client in X-Forwarded-For; from anyone else that header is ignored. The default
# (127.0.0.1) trusts nobody: set it to the proxy network when a proxy is in front of this container.
# The value is filled in by the nginx image from the TRUSTED_PROXY_CIDR environment variable.
set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Live updates (server-sent events): never buffer, keep the stream open
    location = /api/events {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        # $http_host keeps the port: the backend compares it with the request's Origin header
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Backend API, health check and Swagger docs share this origin, so no CORS setup is needed
    location /api/ {
        proxy_pass http://backend:8080;
        # $http_host keeps the port: the backend compares it with the request's Origin header
        proxy_set_header Host $http_host;
        # The backend reads the client address from X-Real-IP (CLIENT_IP_HEADER) for the login
        # rate limit; setting it here overwrites anything a client sent
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Inbox search can scan several Mail.tm pages
        proxy_read_timeout 60s;
    }

    location = /health {
        proxy_pass http://backend:8080;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Swagger UI. DOCS_ENABLED=false (production compose) answers 404 instead of forwarding
    location /docs {
        set $docs_enabled "${DOCS_ENABLED}";
        if ($docs_enabled != "true") {
            return 404;
        }
        proxy_pass http://backend:8080;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Vite emits content-hashed file names, so these can be cached forever
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Client-side routes (/inbox, /accounts, ...) all load the SPA
    location / {
        add_header Cache-Control "no-cache";
        # A page opened from the app (an email link) gets no window.opener, whatever its rel
        add_header Cross-Origin-Opener-Policy "same-origin";
        try_files $uri $uri/ /index.html;
    }
}
